# Токен от @BotFather. Сам файл .env в git не попадает.
BOT_TOKEN=
# Адрес игры (Mini App), обязательно. Должен быть https, например https://<сайт игры>/
WEBAPP_URL=

# --- Сервер очков (всё ниже можно не трогать) ---
# Порт сервера на этом компьютере.
API_PORT=8080
# Постоянный https-адрес сервера: свой домен или прямой вход через Caddy, например
# https://1-2-3-4.sslip.io:8443. Если задан, бот не запускает и не опрашивает туннель (TUNNEL_METRICS
# не используется) и отдаёт этот адрес игре и панели. Пусто — бесплатный туннель Cloudflare, как раньше.
PUBLIC_API_URL=
# TUNNEL=off — не запускать туннель (очки сохраняться не будут, если нет PUBLIC_API_URL).
TUNNEL=
# Файл базы с очками и достижениями.
DB_FILE=scores.db
# Через запятую: сайты, которым разрешено обращаться к серверу (CORS и WebSocket).
# Пусто — только сайт из WEBAPP_URL.
ALLOWED_ORIGINS=
# Коммит для /api/health. Пусто — берётся из файла bot/.commit или из git, иначе "unknown".
GIT_COMMIT=
# Telegram id владельца (администраторов) через запятую: только им доступны служебные команды
# (/stats, /top, /invite, /wallet, /refund…, /admin — ссылка на панель) и им приходят сообщения игроков боту. Пусто — всё это выключено.
# Свой id можно узнать, например, у @userinfobot.
ADMIN_ID=
# Адрес метрик cloudflared, запущенного отдельной службой (см. deploy/tgmario-tunnel.service),
# например 127.0.0.1:20241. Тогда бот не запускает свой туннель, а берёт адрес у службы,
# и автообновления бота адрес не меняют. Пусто — бот поднимает туннель сам, как раньше.
TUNNEL_METRICS=
# Вход в веб-панель владельца (адрес <сервер>/admin, ссылку присылает /admin в боте).
# Логин — любой; вместо пароля хранится только его хэш: npm run admin:password печатает готовую строку.
# Пусто (любое из двух) — панель выключена.
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
